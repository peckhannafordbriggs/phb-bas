# Copy to .env. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Niagara station
# ---------------------------------------------------------------------------
# For the mock station:   http://127.0.0.1:8099
# For a real JACE:        https://<ip>   (add :port if not 443)
NIAGARA_BASE_URL=http://127.0.0.1:8099

# HTTP Basic. Requires a Niagara user whose Authentication Scheme Name is
# HTTPBasicScheme, with a READ-ONLY, non-superuser role. Such an account cannot
# log into Workbench or the web UI — that is expected and correct.
NIAGARA_USER=test
NIAGARA_PASS=test

# Alternative for testing before a service account exists: log into the station
# web UI in a browser, copy the session cookie, paste it here, and leave
# NIAGARA_USER/PASS empty. Expires with your browser session.
NIAGARA_COOKIE=

# Niagara ships a self-signed certificate. Set to 0 for a real station until the
# fingerprint is pinned or a proper certificate is installed. The collector logs
# the SHA-256 fingerprint on every discovery run so you can pin it.
NIAGARA_VERIFY_TLS=1
NIAGARA_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The phb-platform database. Tables live in public with a bas_ prefix and are
# managed by Prisma - apply the phb-platform migrations before running this.
#
# This ONE line also decides where the nightly backup and the restore test go;
# Backup-BasDatabase.ps1 and Test-BasRestore.ps1 read it from .env too. There is
# no second setting.
#
# The old standalone database (postgresql://bas:...@localhost:5432/bas, tables in
# a 'bas' schema with singular names) is the rollback path. Both layouts are
# supported by the backup scripts; the collector's SQL targets the platform.
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/phb_platform

# ---------------------------------------------------------------------------
# Where this station sits in the hierarchy
# ---------------------------------------------------------------------------
BAS_ORG_NAME=PHB
BAS_SITE_NAME=Lab Building
BAS_SITE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Collection behaviour
# ---------------------------------------------------------------------------
# How often `run` collects. 900s = 15 minutes.
#
# Counterintuitive but important: polling MORE often is gentler on the JACE, not
# harsher. The daily data volume is identical either way; smaller windows just
# mean lower peak memory per request in the station's heap, and a much larger
# margin before the station overwrites records we have not collected yet.
POLL_INTERVAL_S=900

# Maximum time span and record count per request. Both bounded because the thing
# on the other end is a building controller running control logic, not a
# database. Niagara's own preset queries cap at 1000 records.
MAX_WINDOW_HOURS=24
MAX_RECORDS_PER_REQUEST=1000

# How far back to reach on a point's very first collection.
INITIAL_BACKFILL_DAYS=30

# The roll-horizon guard. Refuses to run when a point's history capacity is too
# small for the poll interval, because that failure is silent and permanent:
# the station overwrites records, nothing logs an error, and it surfaces months
# later as holes in a chart.
#
# Requires public.bas_points.capacity and public.bas_points.collection_interval_s to be filled
# in from Workbench — oBIX does not expose them.
ENFORCE_ROLL_GUARD=1
ROLL_SAFETY_FACTOR=4
