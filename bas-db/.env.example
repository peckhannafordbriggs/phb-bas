# Copy to .env. .env is gitignored.
#
# Matches docker-compose.yml as shipped. If you are using a Postgres you
# installed yourself, change the user, password, and port to match it.
#
# The password here is fine to commit as an example because this database is
# local-only and holds nothing sensitive. When this moves to a real host, the
# credential comes from somewhere else and never from a file in the repo.

DATABASE_URL=postgresql://bas:bas_local_dev_only@localhost:5432/bas
